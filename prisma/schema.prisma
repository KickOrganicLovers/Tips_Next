// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int          @id @default(autoincrement())
  email    String       @unique
  password String
  profile  UserProfile? @relation()
}

model UserProfile {
  userId           Int       @id
  username         String?
  profileImageUrl  String?
  introduction     String?
  user             User      @relation(fields: [userId], references: [id])
  likes            Like[]
  articleCreatedBy Article[]
}

model EmailOnVerifying {
  email       String   @unique
  hashedToken String
  expiration  DateTime
  createdAt   DateTime @default(now())
}

model Category {
  id           Int        @id @default(autoincrement())
  categoryName String
  parentId     Int?
  parent       Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryParent")
}

model Article {
  id                Int         @unique @default(autoincrement())
  title             String
  thumbnailImageUrl String
  contents          String
  tags              String[]
  categoryId        Int
  authorId          Int
  authorProfile     UserProfile @relation(fields: [authorId], references: [userId])
  likes             Like[]
}

model Like {
  id        String      @id @default(cuid())
  user      UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId    Int
  article   Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int

  createdAt DateTime @default(now())

  @@unique([userId, articleId]) // 同じユーザーが同じ記事に対して1回だけいいねできるようにする
}
