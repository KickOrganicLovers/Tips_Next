// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String       @id @default(cuid())
  email    String       @unique
  password String
  profile  UserProfile? @relation()
}

model UserProfile {
  userId           String          @id
  username         String?
  profileImageUrl  String?
  introduction     String?
  user             User            @relation(fields: [userId], references: [id])
  likes            Like[]
  articleCreatedBy Article[]
  comments         Comment[]
  followings       Follow[]        @relation("following")
  followers        Follow[]        @relation("follower")
  watchHistories   WatchHistory[]
  createdAt        DateTime        @default(now())
  searchHistories  SearchHistory[]
}

model EmailOnVerifying {
  email       String   @unique
  hashedToken String
  expiration  DateTime
  createdAt   DateTime @default(now())
}

model Article {
  id                String         @id @default(cuid())
  title             String
  thumbnailImageUrl String
  contents          String
  tags              Tag[]          @relation("ArticleTags")
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id])
  authorId          String
  authorProfile     UserProfile    @relation(fields: [authorId], references: [userId])
  likes             Like[]
  comments          Comment[]
  watchHistories    WatchHistory[]
  createdAt         DateTime       @default(now())
}

model Category {
  id           String     @id @default(cuid())
  categoryName String
  parentId     String?
  parent       Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryParent")
  articles     Article[]
}

model Tag {
  id       String    @id @default(cuid())
  tagName  String    @unique
  articles Article[] @relation("ArticleTags")
}

model Like {
  id        String      @id @default(cuid())
  user      UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId    String
  article   Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  createdAt DateTime    @default(now())

  @@unique([userId, articleId]) // 同じユーザーが同じ記事に対して1回だけいいねできるようにする
}

model Comment {
  id          String      @id @default(cuid())
  contents    String
  userProfile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId      String
  article     Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId   String
  createdAt   DateTime    @default(now())
}

model Follow {
  id                   String      @id @default(cuid())
  following            String
  followingWithProfile UserProfile @relation("following", fields: [following], references: [userId])
  follower             String
  followerWithProfile  UserProfile @relation("follower", fields: [follower], references: [userId])
  createdAt            DateTime    @default(now())

  @@unique([following, follower])
}

model WatchHistory {
  id        String      @id @default(cuid())
  user      UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId    String
  article   Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  createdAt DateTime    @default(now())
}

model SearchHistory {
  id          String      @id @default(cuid())
  userId      String
  userProfile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  searchQuery String

  createdAt DateTime @default(now())

  @@unique([userId, searchQuery])
}
